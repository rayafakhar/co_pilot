{
  "name": "northstar-simulated-flight-map",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal MapLibre and Turf assets for the Northstar Django simulation",
  "scripts": {
    "build": "npm run build:map",
    "build:map": "node scripts/build-network-map.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:generated": "npm run build && git diff --exit-code -- tracker/static/tracker/dist"
  },
  "dependencies": {
    "@turf/along": "7.3.5",
    "@turf/bearing": "7.3.5",
    "@turf/great-circle": "7.3.5",
    "@turf/helpers": "7.3.5",
    "@turf/length": "7.3.5",
    "code-combiner": "^1.0.0",
    "maplibre-gl": "5.24.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "vitest": "4.1.10"
  }
}
