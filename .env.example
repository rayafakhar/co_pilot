DJANGO_SECRET_KEY=replace-this-for-any-non-local-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional: DJANGO_DB_PATH=C:/absolute/path/to/local.sqlite3
# Optional: DJANGO_STATIC_ROOT=C:/absolute/path/to/collected-static
# Optional public raster tiles for the simulated network map:
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
